# deps
/node_modules

# generated content
.source
# `content/docs/reference/` is auto-generated by site/scripts/build-{command,schema}-reference.mjs.
# `lib/stats.json` is auto-generated by site/scripts/build-stats.mjs.
# `lib/roadmap.json` is auto-generated by site/scripts/build-roadmap.mjs from .ai/plans/ + .ai/state/STATE.md.
# All three ARE committed because Vercel uploads only `site/` (not the monorepo plugins/ + .ai/ siblings),
# so the build step on Vercel can't regenerate them from source. Run
# `pnpm --filter @maude/site gen:reference`, `pnpm --filter @maude/site gen:stats`,
# and `pnpm --filter @maude/site gen:roadmap` after editing plugin assets, .mdx pages,
# or plan/state files and commit the diff. CI guards drift.

# test & build
/coverage
