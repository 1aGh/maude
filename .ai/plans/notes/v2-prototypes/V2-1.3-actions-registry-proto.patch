+
+/** Every menu path an action appears at ("Menu › File › Export…"). Derived — never declared. */
+export function menuPaths(tree: MenuNode[], byId: Map<ActionId, ActionDef>): Map<ActionId, string[]> {
+  const out = new Map<ActionId, string[]>();
+  const walk = (nodes: MenuNode[], trail: string[]) => {
+    for (const n of nodes) {
+      if ('sep' in n) continue;
+      if ('submenu' in n) {
+        walk(n.items, [...trail, n.submenu]);
+        continue;
+      }
+      const a = byId.get(n.id);
+      const path = [...trail, a?.label ?? n.id].join(' › ');
+      out.set(n.id, [...(out.get(n.id) ?? []), path]);
+    }
+  };
+  walk(tree, ['Menu']);
+  return out;
+}
diff --git a/apps/studio/actions/resolve.ts b/apps/studio/actions/resolve.ts
new file mode 100644
index 000000000..8c3532bc6
--- /dev/null
+++ b/apps/studio/actions/resolve.ts
@@ -0,0 +1,98 @@
+// actions/resolve.ts — PROTOTYPE for spike V2-1.3. Pure: predicate evaluation + focus-scoped key
+// resolution (Gate 0 C26). No DOM, no React — runs in the shell, the canvas iframe, the server
+// (predicate half) and tests.
+
+import { hasCommandMod, TEXT_RESERVED } from './keys.ts';
+import {
+  type ActionDef,
+  type Chord,
+  type KeyBinding,
+  type KeyCtx,
+  LAYERS,
+  type Layer,
+  type Pred,
+  ROLE_RANK,
+} from './types.ts';
+
+export function holds(p: Pred | undefined, ctx: KeyCtx): boolean {
+  if (!p) return true;
+  if (p.minRole && ROLE_RANK[ctx.role] < ROLE_RANK[p.minRole]) return false;
+  if (p.shell && !p.shell.includes(ctx.shell)) return false;
+  if (p.notShell?.includes(ctx.shell)) return false;
+  if (p.mode && !p.mode.includes(ctx.mode)) return false;
+  if (p.focus && !p.focus.includes(ctx.focus)) return false;
+  if (p.selection && !p.selection.includes(ctx.selection)) return false;
+  if (p.facts && !p.facts.every((f) => ctx.facts.has(f))) return false;
+  if (p.notFacts?.some((f) => ctx.facts.has(f))) return false;
+  if (p.any && !p.any.some((q) => holds(q, ctx))) return false;
+  return true;
+}
+
+/** Rule 12 — the one visibility test every surface calls. */
+export function isVisible(a: ActionDef, ctx: KeyCtx): boolean {
+  return holds(a.visible, ctx);
+}
+export function isEnabled(a: ActionDef, ctx: KeyCtx): boolean {
+  return isVisible(a, ctx) && holds(a.enabled, ctx);
+}
+
+export interface Bound {
+  action: ActionDef;
+  binding: KeyBinding;
+}
+
+/** Index: chord → every binding that uses it. Built once per registry. */
+export function indexKeys(actions: readonly ActionDef[]): Map<Chord, Bound[]> {
+  const m = new Map<Chord, Bound[]>();
+  for (const action of actions)
+    for (const binding of action.keys ?? []) {
+      const list = m.get(binding.chord) ?? [];
+      list.push({ action, binding });
+      m.set(binding.chord, list);
+    }
+  return m;
+}
+
+function layerActive(layer: Layer, ctx: KeyCtx): boolean {
+  // 'timeline' bindings need timeline focus; the rest are reachable from canvas or chrome focus.
+  if (layer === 'timeline') return ctx.focus === 'timeline';
+  return true;
+}
+
+function bindingLive(b: Bound, ctx: KeyCtx): boolean {
+  if (ctx.focus === 'text') {
+    const inText = b.binding.inText ?? (hasCommandMod(b.binding.chord) && !TEXT_RESERVED.has(b.binding.chord));
+    if (!inText) return false;
+  }
+  if (ctx.focus === 'modal' && !b.binding.inModal) return false;
+  return layerActive(b.binding.layer, ctx) && isVisible(b.action, ctx) && holds(b.binding.when, ctx);
+}
+
+export interface Resolution {
+  action: ActionDef;
+  binding: KeyBinding;
+  /** Same-layer competitors — must be empty; the uniqueness test enforces it. */
+  ambiguous: Bound[];
+}
+
+/** C26: focused text field > timeline focus > selection > mode tools > global. The first layer
+ *  (in LAYERS order) that has a live binding for the chord wins; a disabled winner still
+ *  swallows the key (no fall-through), so a key never does something different just because
+ *  the thing it targets is momentarily unavailable. */
+export function resolveChord(
+  index: Map<Chord, Bound[]>,
+  chord: Chord,
+  ctx: KeyCtx,
+  press: 'tap' | 'hold' = 'tap'
+): Resolution | null {
+  // Tap and hold never compete: Space can be "play" on tap and "Hand" while held (CONTRACT §7).
+  const live = (index.get(chord) ?? []).filter(
+    (b) => (press === 'hold') === !!b.binding.hold && bindingLive(b, ctx)
+  );
+  if (!live.length) return null;
+  for (const layer of LAYERS) {
+    const here = live.filter((b) => b.binding.layer === layer);
+    if (here.length) return { action: here[0].action, binding: here[0].binding, ambiguous: here.slice(1) };
+  }
+  return null;
+}
diff --git a/apps/studio/actions/types.ts b/apps/studio/actions/types.ts
new file mode 100644
index 000000000..c6b1fac60
--- /dev/null
+++ b/apps/studio/actions/types.ts
@@ -0,0 +1,137 @@
+// actions/types.ts — PROTOTYPE for spike V2-1.3 (not committed; the contract note is the deliverable).
+// Erasable TypeScript only (no enums / namespaces / parameter properties) so Bun, the client
+// bundle, the canvas runtime bundle and Node 24 (type stripping) can all import it.
+
+export type ActionId = string; // dotted, stable, append-only: 'canvas.new', 'view.panels.toggle'
+
+/** Hub roles (A6). A local project is 'owner'. */
+export type Role = 'view' | 'comment' | 'edit' | 'owner';
+export const ROLE_RANK: Readonly<Record<Role, number>> = { view: 0, comment: 1, edit: 2, owner: 3 };
+
+/** Where the client runs (rule 12 — predicates name shells, never ad-hoc flags). */
+export type Shell = 'desktop' | 'browser' | 'cloud' | 'viewer' | 'embed' | 'home';
+
+/** Shell-owned mode (V2-1.2). 'viewing' = the read-only slot in the Share cluster. */
+export type Mode = 'edit' | 'preview' | 'present' | 'viewing';
+
+/** What currently has keyboard focus — computed by the side that receives the event. */
+export type Focus = 'text' | 'timeline' | 'canvas' | 'chrome' | 'modal';
+
+/** Kind of the current selection (C26 'selection' layer discriminant). */
+export type SelKind =
+  | 'none'
+  | 'artboard'
+  | 'object'
+  | 'annotation'
+  | 'video-artboard'
+  | 'generated-image'
+  | 'clip';
+
+/** Resolution layers, highest priority first (Gate 0 C26). 'text' never appears on a binding:
+ *  a focused text field is not a layer that owns commands, it is the thing that swallows keys. */
+export const LAYERS = ['timeline', 'selection', 'tools', 'global'] as const;
+export type Layer = (typeof LAYERS)[number];
+
+/** Named runtime booleans a predicate may test. Closed set: adding one is a registry change. */
+export type Fact =
+  | 'native' // running inside the Tauri shell
+  | 'canvasOpen'
+  | 'videoCanvas'
+  | 'timelineVisible'
+  | 'linkedHub'
+  | 'aiConnected'
+  | 'online'
+  | 'hasShareLink'
+  | 'canUndo'
+  | 'canRedo'
+  | 'presenting'
+  | 'commentFocused'
+  | 'photoTab';
+
+/** Declarative predicate — serialisable into the manifest, evaluable on client, iframe and server
+ *  (server evaluates only minRole/shell). All present fields must hold (AND). */
+export interface Pred {
+  minRole?: Role;
+  shell?: Shell[];
+  notShell?: Shell[];
+  mode?: Mode[];
+  focus?: Focus[];
+  selection?: SelKind[];
+  facts?: Fact[]; // all must be true
+  notFacts?: Fact[]; // all must be false
+  any?: Pred[]; // at least one must hold
+}
+
+/** Canonical chord string, macOS glyph order ⌃⌥⇧⌘ then the key: '⇧⌘E', '⌥⌘↵', 'V', '?', 'Space',
+ *  'F1', '←'. Letters upper-case. Produced only by keys.ts `chord()` / `chordFromEvent()`. */
+export type Chord = string;
+
+export interface KeyBinding {
+  chord: Chord;
+  layer: Layer;
+  /** Extra condition for THIS binding (on top of the action's `visible`). */
+  when?: Pred;
+  /** Fires while a text field has focus. Default: chord has ⌘/⌃ and is not TEXT_RESERVED. */
+  inText?: boolean;
+  /** Fires while a modal (dialog/sheet/menu/popover) is open. Default false. */
+  inModal?: boolean;
+  /** Hold-to-activate (Space = Hand while held). */
+  hold?: boolean;
+  /** Not shown as the primary key anywhere; listed in "?" as an alternative (⌘G for ⌥⌘G). */
+  alias?: boolean;
+}
+
+export type Exec = 'shell' | 'canvas' | 'native' | 'server';
+
+export type HelpGroup =
+  | 'edit-tools'
+  | 'preview-tools'
+  | 'file'
+  | 'canvas'
+  | 'panels-ai'
+  | 'objects'
+  | 'timeline';
+
+export interface ActionDef {
+  id: ActionId;
+  /** CONTRACT §3 words. One label everywhere (menu, ⌘K, "?", native, docs). */
+  label: string;
+  kind: 'command' | 'toggle' | 'tool' | 'place';
+  icon?: string;
+  /** First binding is the primary (shown in menus and ⌘K). */
+  keys?: KeyBinding[];
+  /** Which runtime owns the handler. */
+  exec: Exec;
+  /** Rule 12: the ONE predicate set — menus, ⌘K, "?", panels, native menu and (minRole) server. */
+  visible?: Pred;
+  /** Shown but greyed. Never used to hide. */
+  enabled?: Pred;
+  /** May be triggered by a chord or click forwarded from the canvas iframe (DDR-054).
+   *  Only legal for effect 'none' (opens UI, mutates nothing) — enforced by test. */
+  fromCanvas?: boolean;
+  /** Non-menu homes ('Canvases › Advanced', 'Inspector › Advanced', 'Toolbar · Edit').
+   *  Menu homes are derived from menu.ts and must not be repeated here. */
+  homes?: string[];
+  help?: { group: HelpGroup; order: number; advanced?: boolean };
+  native?: { menu: 'App' | 'File' | 'Edit' | 'View' | 'Window' | 'Help'; order: number };
+  /** Old ids that still resolve to this action (append-only; renames never break callers). */
+  aliases?: ActionId[];
+  search?: { keywords?: string[]; hidden?: boolean };
+}
+
+/** "?" › Advanced › "Keys and tools that moved" (D1–D4, rule 13). */
+export interface MovedKey {
+  was: string; // 'Changes ⇧⌘G'
+  now: string; // 'Version history ⌥⌘H'
+  note?: string; // 'T is Text'
+  to?: ActionId;
+}
+
+export interface KeyCtx {
+  role: Role;
+  shell: Shell;
+  mode: Mode;
+  focus: Focus;
+  selection: SelKind;
+  facts: ReadonlySet<Fact>;
+}
diff --git a/apps/studio/actions/v1.ts b/apps/studio/actions/v1.ts
