+++ b/apps/studio/actions/keys.ts
@@ -0,0 +1,144 @@
+// actions/keys.ts — PROTOTYPE for spike V2-1.3. Chord normalisation shared by shell, iframe,
+// generator and tests. One canonical form so '⌘⇧M', '⌘ ⇧ M' and '⇧⌘M' are the same chord.
+
+import type { Chord } from './types.ts';
+
+const MOD_ORDER = ['⌃', '⌥', '⇧', '⌘'] as const; // macOS menu order (CONTRACT §2: ⌥⇧⌘)
+const NAMED: Record<string, string> = {
+  Enter: '↵',
+  Return: '↵',
+  '↩': '↵',
+  Escape: 'esc',
+  Esc: 'esc',
+  ' ': 'Space',
+  Spacebar: 'Space',
+  ArrowLeft: '←',
+  ArrowRight: '→',
+  ArrowUp: '↑',
+  ArrowDown: '↓',
+  Backspace: '⌫',
+  Delete: '⌦',
+  Tab: 'tab',
+  '-': '−',
+  '–': '−',
+};
+
+/** Parse any human spelling ('⌘ ⇧ M', '⌘⇧M', 'Cmd+Shift+M', 'Esc', '⌘ click') into canonical form.
+ *  Returns null for pointer gestures ('⌘ click', '⌘ hover') — those are not key bindings. */
+export function chord(spec: string): Chord | null {
+  let s = spec.trim();
+  if (/click|hover|drag|scroll/i.test(s)) return null;
+  const mods = new Set<string>();
+  const words: Record<string, string> = {
+    cmd: '⌘',
+    command: '⌘',
+    meta: '⌘',
+    ctrl: '⌃',
+    control: '⌃',
+    alt: '⌥',
+    opt: '⌥',
+    option: '⌥',
+    shift: '⇧',
+  };
+  s = s.replace(/\b(cmd|command|meta|ctrl|control|alt|opt|option|shift)\s*\+?\s*/gi, (_m, w) => {
+    mods.add(words[w.toLowerCase()]);
+    return '';
+  });
+  // Peel glyph modifiers off the front (any order, spaces allowed).
+  for (;;) {
+    s = s.replace(/^\s+/, '');
+    const g = MOD_ORDER.find((m) => s.startsWith(m));
+    if (!g || s.length === g.length) break; // a lone '⇧' would be a key, not a modifier
+    mods.add(g);
+    s = s.slice(g.length);
+  }
+  let key = s.trim();
+  if (NAMED[key]) key = NAMED[key];
+  if (/^[a-z]$/i.test(key)) key = key.toUpperCase();
+  const prefix = MOD_ORDER.filter((m) => mods.has(m)).join('');
+  return prefix + key;
+}
+
+const CODE_KEY: Record<string, string> = {
+  Minus: '−',
+  Equal: '=',
+  Slash: '/',
+  Backslash: '\\',
+  BracketLeft: '[',
+  BracketRight: ']',
+  Comma: ',',
+  Period: '.',
+  Semicolon: ';',
+  Quote: "'",
+  Backquote: '`',
+};
+
+/** Minimal shape of a KeyboardEvent the resolver needs (testable without a DOM). */
+export interface KeyEventLike {
+  key: string;
+  code?: string;
+  metaKey?: boolean;
+  ctrlKey?: boolean;
+  altKey?: boolean;
+  shiftKey?: boolean;
+}
+
+/** Canonical chord from a keyboard event.
+ *  - `e.key` when it is a plain ASCII letter/digit/symbol (layout-aware: what macOS menus show);
+ *  - else `e.code` (physical) — covers ⌥ chords on macOS (⌥⌘P gives e.key 'π') and the Czech
+ *    number row (⌘1 gives e.key '+').
+ *  - Shift is dropped for shifted symbols whose key already encodes it ('?', '+', ':').
+ *  - ⌃ folds into ⌘ (Windows/Linux browsers), matching v1's `metaKey || ctrlKey`. */
+export function chordFromEvent(e: KeyEventLike): Chord {
+  const mods = new Set<string>();
+  if (e.metaKey || e.ctrlKey) mods.add('⌘');
+  if (e.altKey) mods.add('⌥');
+  let key = e.key;
+  if (NAMED[key]) key = NAMED[key];
+  else if (/^F\d{1,2}$/.test(key)) {
+    /* F1…F12 */
+  } else if (/^[\x21-\x7e]$/.test(key)) {
+    if (/^[a-z]$/i.test(key)) key = key.toUpperCase();
+  } else if (e.code) {
+    const m = /^Key([A-Z])$/.exec(e.code) ?? /^Digit(\d)$/.exec(e.code);
+    key = m ? m[1] : (CODE_KEY[e.code] ?? key);
+  }
+  // Digits count as shift-encoded too: a layout that types digits WITH ⇧ (Czech QWERTZ: the
+  // unshifted number row is "+ěščřžýáíé") must still reach ⌘0 / ⌘1 — v1 ignored shift there.
+  const shiftEncodedInKey = !/^[A-Z]$/.test(key) && !NAMED_VALUES.has(key) && !/^F\d/.test(key);
+  if (e.shiftKey && !shiftEncodedInKey) mods.add('⇧');
+  return MOD_ORDER.filter((m) => mods.has(m)).join('') + key;
+}
+const NAMED_VALUES = new Set(Object.values(NAMED));
+
+export function hasCommandMod(c: Chord): boolean {
+  return c.includes('⌘') || c.includes('⌃');
+}
+
+/** Chords a focused text field owns natively (C26: the text field wins). */
+export const TEXT_RESERVED: ReadonlySet<Chord> = new Set(
+  [
+    '⌘Z',
+    '⇧⌘Z',
+    '⌘Y',
+    '⌘A',
+    '⌘C',
+    '⌘X',
+    '⌘V',
+    '⇧⌘V',
+    '⌥⇧⌘V',
+    '⌘B',
+    '⌘I',
+    '⌘U',
+    '⌘←',
+    '⌘→',
+    '⌘↑',
+    '⌘↓',
+    '⇧⌘←',
+    '⇧⌘→',
+    '⌥←',
+    '⌥→',
+    '⌘⌫',
+    '⌥⌫',
+  ].map((c) => chord(c) as Chord)
+);
