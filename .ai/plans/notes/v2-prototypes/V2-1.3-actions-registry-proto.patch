+  { id: 'annotation.ungroup', label: 'Ungroup', kind: 'command', exec: 'canvas', visible: CAN_COMMENT, keys: [k('⇧⌘G', 'selection', { when: ANN })] },
+  { id: 'annotation.lock', label: 'Lock / unlock', kind: 'toggle', exec: 'canvas', visible: CAN_COMMENT, keys: [k('⇧⌘L', 'selection', { when: ANN })] },
+  { id: 'annotation.duplicate', label: 'Duplicate', kind: 'command', exec: 'canvas', visible: CAN_COMMENT, keys: [k('⌘D', 'selection', { when: ANN })] },
+  { id: 'annotation.remove', label: 'Remove', kind: 'command', exec: 'canvas', visible: CAN_COMMENT, keys: [k('⌫', 'selection', { when: ANN })] },
+  { id: 'annotation.nudge', label: 'Nudge', kind: 'command', exec: 'canvas', visible: CAN_COMMENT, keys: ['←', '→', '↑', '↓', '⇧←', '⇧→', '⇧↑', '⇧↓'].map((c) => k(c, 'selection', { when: ANN })) },
+  // ── timeline layer (C26 + 07): S split, I/O loop, ←/→ frames, ⌘+/− zoom; ⌘B always splits ──
+  { id: 'timeline.split', label: 'Split at playhead', kind: 'command', exec: 'shell', visible: CAN_EDIT, keys: [k('S', 'timeline'), k('⌘B', 'timeline', { alias: true })] },
+  { id: 'timeline.split-anywhere', label: 'Split at playhead', kind: 'command', exec: 'shell', visible: CAN_EDIT, keys: [k('⌘B', 'selection', { when: { facts: ['timelineVisible'] } })] },
+  { id: 'timeline.loop-in', label: 'Loop in', kind: 'command', exec: 'shell', keys: [k('I', 'timeline')] },
+  { id: 'timeline.loop-out', label: 'Loop out', kind: 'command', exec: 'shell', keys: [k('O', 'timeline')] },
+  { id: 'timeline.step', label: 'Step a frame', kind: 'command', exec: 'shell', keys: ['←', '→', '⇧←', '⇧→'].map((c) => k(c, 'timeline')) },
+  { id: 'timeline.zoom-in', label: 'Zoom timeline in', kind: 'command', exec: 'shell', keys: [k('⌘+', 'timeline'), k('⌘=', 'timeline', { alias: true })] },
+  { id: 'timeline.zoom-out', label: 'Zoom timeline out', kind: 'command', exec: 'shell', keys: [k('⌘−', 'timeline')] },
+  { id: 'timeline.play', label: 'Play / pause', kind: 'toggle', exec: 'shell', keys: [k('Space', 'timeline')] },
+];
diff --git a/apps/studio/test/actions-registry-proto.test.ts b/apps/studio/test/actions-registry-proto.test.ts
