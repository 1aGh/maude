+++ b/apps/studio/actions/v1.ts
@@ -0,0 +1,89 @@
+// actions/v1.ts — PROTOTYPE for spike V2-1.3: today's (v1) global bindings expressed as registry
+// entries, to prove the schema can represent every one and the resolver reproduces today's
+// handler choice. Ids are v1 handler names; labels are v1 strings. Not product code.
+
+import { chord } from './keys.ts';
+import type { ActionDef, KeyBinding, Layer, Pred } from './types.ts';
+
+const k = (spec: string, layer: Layer, extra: Partial<KeyBinding> = {}): KeyBinding => ({
+  chord: chord(spec) as string,
+  layer,
+  ...extra,
+});
+const SHELL_FOCUS: Pred = { focus: ['chrome', 'timeline', 'text', 'modal'] }; // v1: shell window listener
+const CANVAS_FOCUS: Pred = { focus: ['canvas', 'text'] }; // v1: iframe listeners
+const NOT_VIEWER: Pred = { minRole: 'edit' };
+
+/** use-keyboard-shortcuts.jsx (shell window keydown) + inspect.ts forwarder + canvas-lib +
+ *  input-router `classify` + use-keyboard-discipline. `inText` mirrors v1's early return. */
+export const V1_ACTIONS: ActionDef[] = [
