@@ -0,0 +1,231 @@
+// PROTOTYPE test for spike V2-1.3 (not committed). Proves:
+//  1. every v1 binding is representable in the registry schema;
+//  2. the pure resolver reproduces today's handler choice for each (chord, focus, context);
+//  3. the per-scope uniqueness check runs over the whole finite context lattice and reports
+//     exactly the same-layer ambiguities (none allowed in the real registry).
+import { describe, expect, test } from 'bun:test';
+
+import { chord, chordFromEvent } from '../actions/keys.ts';
+import { indexKeys, resolveChord } from '../actions/resolve.ts';
+import type { ActionDef, Fact, Focus, KeyCtx, Mode, Role, SelKind, Shell } from '../actions/types.ts';
+import { LAYERS } from '../actions/types.ts';
+import { V1_ACTIONS } from '../actions/v1.ts';
+
+const ctx = (o: Partial<Omit<KeyCtx, 'facts'>> & { facts?: Fact[] } = {}): KeyCtx => ({
+  role: o.role ?? 'owner',
+  shell: o.shell ?? 'browser',
+  mode: o.mode ?? 'edit',
+  focus: o.focus ?? 'chrome',
+  selection: o.selection ?? 'none',
+  facts: new Set<Fact>(o.facts ?? ['canvasOpen']),
+});
+
+const idx = indexKeys(V1_ACTIONS);
+const R = (spec: string, c: KeyCtx) => resolveChord(idx, chord(spec) as string, c)?.action.id ?? null;
+
+describe('chord normalisation', () => {
+  test('spellings converge', () => {
+    for (const s of ['⌘⇧M', '⌘ ⇧ M', '⇧⌘M', 'Cmd+Shift+M', 'shift+cmd+m']) expect(chord(s)).toBe('⇧⌘M');
+    expect(chord('Esc')).toBe('esc');
+    expect(chord('⌘ click')).toBeNull();
+    expect(chord('⌥⌘↵')).toBe('⌥⌘↵');
+  });
+  test('events', () => {
+    expect(chordFromEvent({ key: 'E', code: 'KeyE', metaKey: true, shiftKey: true })).toBe('⇧⌘E');
+    expect(chordFromEvent({ key: '?', code: 'Slash', shiftKey: true })).toBe('?');
+    expect(chordFromEvent({ key: 'π', code: 'KeyP', metaKey: true, altKey: true })).toBe('⌥⌘P'); // macOS ⌥ chord
+    expect(chordFromEvent({ key: 'Enter', code: 'Enter', metaKey: true, altKey: true })).toBe('⌥⌘↵');
+    expect(chordFromEvent({ key: 'k', code: 'KeyK', ctrlKey: true })).toBe('⌘K'); // ⌃ folds into ⌘ (v1 parity)
+    expect(chordFromEvent({ key: 'ArrowLeft', code: 'ArrowLeft', shiftKey: true })).toBe('⇧←');
+    expect(chordFromEvent({ key: ' ', code: 'Space' })).toBe('Space');
+    expect(chordFromEvent({ key: 'S', code: 'KeyS', shiftKey: true })).toBe('⇧S');
+    // Czech QWERTZ: ⌘1 is typed as ⌘⇧ + the "+" key; ⌘+ is the unshifted "+" key
+    expect(chordFromEvent({ key: '1', code: 'Digit1', metaKey: true, shiftKey: true })).toBe('⌘1');
+    expect(chordFromEvent({ key: '+', code: 'Digit1', metaKey: true })).toBe('⌘+');
+  });
+});
+
+describe('v1 parity — the resolver picks today’s handler', () => {
+  const cases: [string, KeyCtx, string | null][] = [
+    ['⌘K', ctx({ focus: 'text' }), 'v1.palette'],
+    ['⌘K', ctx({ focus: 'canvas' }), 'v1.palette'],
+    ['⌘Z', ctx({ focus: 'chrome' }), 'v1.undo'],
+    ['⌘Z', ctx({ focus: 'timeline' }), 'v1.tl.undo'],
+    ['⌘Z', ctx({ focus: 'text' }), null], // native text undo wins
+    ['T', ctx({ focus: 'chrome' }), 'v1.tree'],
+    ['T', ctx({ focus: 'canvas' }), 'v1.tool.text'],
+    ['T', ctx({ focus: 'text' }), null],
+    ['H', ctx({ focus: 'chrome' }), 'v1.hidden-files'],
+    ['H', ctx({ focus: 'canvas' }), 'v1.tool.hand'],
+    ['N', ctx({ focus: 'chrome' }), 'v1.new-board'],
+    ['N', ctx({ focus: 'canvas' }), 'v1.tool.sticky'],
+    ['N', ctx({ focus: 'canvas', role: 'comment' }), null], // viewer: tool absent
+    ['S', ctx({ focus: 'chrome' }), 'v1.system-view'],
+    ['⇧S', ctx({ focus: 'canvas' }), 'v1.tool.section'],
+    ['⇧⌘A', ctx({ focus: 'chrome', shell: 'desktop', facts: ['native', 'canvasOpen'] }), 'v1.assistant'],
+    ['⇧⌘A', ctx({ focus: 'chrome', shell: 'browser' }), null],
+    ['⇧⌘A', ctx({ focus: 'canvas' }), 'v1.select-all-annotations'],
+    ['⌘,', ctx({ focus: 'chrome', role: 'comment' }), null], // viewer refused
+    ['⌘,', ctx({ focus: 'chrome' }), 'v1.settings'],
+    ['esc', ctx({ focus: 'chrome', facts: ['canvasOpen', 'presenting'] }), 'v1.present-exit'],
+    ['esc', ctx({ focus: 'canvas', facts: ['canvasOpen', 'presenting'] }), 'v1.canvas-escape'], // v1 bug #5, by layer
+    ['⌘B', ctx({ focus: 'timeline' }), 'v1.tl.split'],
+    ['⌘B', ctx({ focus: 'chrome' }), null],
+    ['Space', ctx({ focus: 'timeline' }), 'v1.tl.play'],
+    ['Space', ctx({ focus: 'canvas' }), null], // tap: nothing in v1 canvas; hold → v1.hand-hold (below)
+    ['←', ctx({ focus: 'canvas', selection: 'object' }), 'v1.nudge'],
+    ['←', ctx({ focus: 'timeline' }), 'v1.tl.step'],
+    ['⌫', ctx({ focus: 'chrome', selection: 'artboard' }), 'v1.delete-artboard'],
+    ['⌫', ctx({ focus: 'timeline', selection: 'clip' }), 'v1.tl.remove-clip'],
+    ['⌘=', ctx({ focus: 'canvas' }), 'v1.zoom-in'],
+    ['⌘=', ctx({ focus: 'timeline' }), 'v1.tl.zoom'],
+    ['⌥⌘3', ctx({ focus: 'canvas' }), 'v1.jump-artboard'],
+    ['?', ctx({ focus: 'chrome' }), 'v1.shortcuts'],
+    ['?', ctx({ focus: 'canvas' }), null], // v1: not forwarded from the canvas (finding #10)
+  ];
+  for (const [spec, c, want] of cases)
+    test(`${spec} · focus=${c.focus} role=${c.role} shell=${c.shell} → ${want}`, () => expect(R(spec, c)).toBe(want));
+});
+
+// ── per-scope uniqueness over the finite context lattice ──
+const ROLES: Role[] = ['view', 'comment', 'edit', 'owner'];
+const SHELLS: Shell[] = ['desktop', 'browser', 'cloud', 'viewer', 'embed', 'home'];
+const MODES: Mode[] = ['edit', 'preview', 'present', 'viewing'];
+const FOCI: Focus[] = ['text', 'timeline', 'canvas', 'chrome', 'modal'];
+const SELS: SelKind[] = ['none', 'artboard', 'object', 'annotation', 'video-artboard', 'generated-image', 'clip'];
+const FACT_SETS: Fact[][] = [
+  ['canvasOpen'],
+  ['canvasOpen', 'native'],
+  ['canvasOpen', 'presenting'],
+  ['canvasOpen', 'commentFocused'],
+  ['canvasOpen', 'timelineVisible', 'videoCanvas'],
+  [],
+];
+
+export function ambiguities(actions: readonly ActionDef[]) {
+  const index = indexKeys(actions);
+  const found = new Map<string, Set<string>>();
+  let contexts = 0;
+  for (const role of ROLES)
+    for (const shell of SHELLS)
+      for (const mode of MODES)
+        for (const focus of FOCI)
+          for (const selection of SELS)
+            for (const facts of FACT_SETS) {
+              contexts++;
+              const c: KeyCtx = { role, shell, mode, focus, selection, facts: new Set(facts) };
+              for (const ch of index.keys()) {
+                for (const press of ['tap', 'hold'] as const) { const r = resolveChord(index, ch, c, press);
+                if (r && r.ambiguous.length) {
+                  const key = `${ch} @${r.binding.layer}`;
+                  const ids = found.get(key) ?? new Set<string>();
+                  ids.add(r.action.id);
+                  for (const a of r.ambiguous) ids.add(a.action.id);
+                  found.set(key, ids);
+                }
+                }
+              }
+            }
+  return { contexts, found };
+}
+
+test('per-scope uniqueness — v1 table has no same-layer ambiguity', () => {
+  const t0 = performance.now();
+  const { contexts, found } = ambiguities(V1_ACTIONS);
+  const ms = performance.now() - t0;
+  console.log(`lattice: ${contexts} contexts × ${idx.size} chords in ${ms.toFixed(0)} ms`);
+  console.log('ambiguities:', [...found].map(([k, v]) => `${k}: ${[...v].join(' | ')}`));
+  expect([...found.keys()]).toEqual([]);
+});
+
+test('the uniqueness check catches a planted collision (red-first)', () => {
+  const planted: ActionDef = {
+    id: 'planted.tree-on-T',
+    label: 'Planted',
+    kind: 'command',
+    exec: 'shell',
+    keys: [{ chord: 'T', layer: 'tools', when: { focus: ['canvas'] } }],
+  };
+  const { found } = ambiguities([...V1_ACTIONS, planted]);
+  expect([...found.keys()]).toContain('T @tools');
+});
+
+test('LAYERS order is C26', () => expect([...LAYERS]).toEqual(['timeline', 'selection', 'tools', 'global']));
+
+// ── v2 spec (CONTRACT §2 + Gate 0) — run the same uniqueness check against the plan's key map ──
+import { V2_ACTIONS } from '../actions/v2.ts';
+
+test('v2 spec key map — per-scope uniqueness', () => {
+  const { contexts, found } = ambiguities(V2_ACTIONS);
+  console.log(`v2 lattice: ${contexts} contexts × ${indexKeys(V2_ACTIONS).size} chords`);
+  console.log('v2 ambiguities:', [...found].map(([k, v]) => `${k}: ${[...v].join(' | ')}`));
+  expect([...found.keys()]).toEqual([]);
+});
+
+describe('v2 spec — C26 resolution examples', () => {
+  const i2 = indexKeys(V2_ACTIONS);
+  const R2 = (spec: string, c: KeyCtx) => resolveChord(i2, chord(spec) as string, c)?.action.id ?? null;
+  const cases: [string, KeyCtx, string | null][] = [
+    ['S', ctx({ focus: 'timeline', selection: 'video-artboard', facts: ['canvasOpen', 'timelineVisible'] }), 'timeline.split'],
+    ['S', ctx({ focus: 'canvas' }), 'tool.section'],
+    ['S', ctx({ focus: 'text' }), null],
+    ['⌘B', ctx({ focus: 'canvas', selection: 'video-artboard', facts: ['canvasOpen', 'timelineVisible'] }), 'timeline.split-anywhere'],
+    ['⌘B', ctx({ focus: 'text', facts: ['canvasOpen', 'timelineVisible'] }), null], // open question Q1
+    ['→', ctx({ focus: 'timeline', selection: 'generated-image' }), 'timeline.step'],
+    ['→', ctx({ focus: 'canvas', selection: 'generated-image' }), 'image.next-take'],
+    ['→', ctx({ focus: 'canvas', selection: 'object' }), 'object.nudge'],
+    ['→', ctx({ focus: 'canvas', mode: 'present' }), 'present.next'],
+    ['⌘+', ctx({ focus: 'timeline' }), 'timeline.zoom-in'],
+    ['⌘+', ctx({ focus: 'canvas' }), 'view.zoom-in'],
+    ['⌘G', ctx({ focus: 'canvas', selection: 'object' }), 'object.frame'],
+    ['⌘G', ctx({ focus: 'canvas', mode: 'preview', selection: 'annotation' }), 'annotation.group'],
+    ['T', ctx({ focus: 'chrome' }), 'tool.text'], // v2: tools work from chrome focus too (D4: T is Text)
+    ['T', ctx({ focus: 'chrome', mode: 'preview' }), 'tool.note-text'],
+    ['N', ctx({ focus: 'canvas', role: 'view' }), null], // Can view: no annotation tools
+    ['N', ctx({ focus: 'canvas', role: 'comment' }), 'tool.sticky'],
+    ['⌘N', ctx({ focus: 'chrome', shell: 'browser' }), null], // browsers never deliver ⌘N
+    ['⌘N', ctx({ focus: 'chrome', shell: 'desktop' }), 'canvas.new'],
+    ['Space', ctx({ focus: 'canvas', selection: 'video-artboard' }), 'video.play'], // tap; hold = Hand (separate press)
+    ['Space', ctx({ focus: 'canvas', mode: 'present' }), 'present.next'],
+    ['I', ctx({ focus: 'timeline' }), 'timeline.loop-in'],
+    ['I', ctx({ focus: 'canvas' }), 'tool.image'],
+  ];
+  for (const [spec, c, want] of cases)
+    test(`${spec} · focus=${c.focus} mode=${c.mode} sel=${c.selection} → ${want}`, () => expect(R2(spec, c)).toBe(want));
+});
+
+test('hold presses resolve separately from taps', () => {
+  const i2 = indexKeys(V2_ACTIONS);
+  const hold = (c: KeyCtx) => resolveChord(i2, 'Space', c, 'hold')?.action.id ?? null;
+  expect(hold(ctx({ focus: 'canvas', selection: 'video-artboard' }))).toBe('tool.hand-hold');
+  expect(hold(ctx({ focus: 'canvas', mode: 'present' }))).toBeNull(); // 04: space moves on in Present
+  expect(resolveChord(idx, 'Space', ctx({ focus: 'canvas' }), 'hold')?.action.id).toBe('v1.hand-hold');
+});
+
+// ── rule 13 — which v1 bindings a v2 binding shadows (they must die in the same commit) ──
+test('rule 13 pairing — v2 bindings that shadow or are shadowed by v1 bindings', () => {
+  const all = [...V1_ACTIONS, ...V2_ACTIONS];
+  const index = indexKeys(all);
+  const pairs = new Map<string, Set<string>>();
+  for (const role of ROLES)
+    for (const shell of SHELLS)
+      for (const mode of MODES)
+        for (const focus of FOCI)
+          for (const selection of SELS)
+            for (const facts of FACT_SETS) {
+              const c: KeyCtx = { role, shell, mode, focus, selection, facts: new Set(facts) };
+              for (const [ch, list] of index) {
+                const live = list.filter((b) => resolveChord(new Map([[ch, [b]]]), ch, c, b.binding.hold ? 'hold' : 'tap'));
+                const v1 = live.filter((b) => b.action.id.startsWith('v1.'));
+                const v2 = live.filter((b) => !b.action.id.startsWith('v1.'));
+                if (v1.length && v2.length) {
+                  const s = pairs.get(ch) ?? new Set<string>();
+                  for (const a of v1) for (const b of v2) s.add(`${a.action.id} ⟷ ${b.action.id}`);
+                  pairs.set(ch, s);
+                }
+              }
+            }
+  const out = [...pairs].map(([ch, s]) => `${ch}: ${[...s].join(', ')}`);
+  console.log(`rule-13 pairs (${out.length} chords):\n` + out.join('\n'));
+  expect(out.length).toBeGreaterThan(0);
+});
