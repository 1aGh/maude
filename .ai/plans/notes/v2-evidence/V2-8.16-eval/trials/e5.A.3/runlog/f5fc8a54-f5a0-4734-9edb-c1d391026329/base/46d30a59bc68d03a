/* ─────────────────────────────────────────────────────────────────────────
 * VÝSLEDKOVÁ KARTA — A4 na šířku, přeložená napůl na A5 na výšku
 *
 * „Výsledky si odneseš na kartě" je z landingu i letáku, takže karta musí být
 * reálný tiskový artefakt, ne jen slib. Dvojlist: A4 LANDSCAPE (297×210 mm) se
 * přeloží svisle uprostřed → dvě A5 portrait stránky (148,5×210 mm). Tiskne se
 * oboustranně, takže jsou to DVA artboardy = dva archy:
 *
 *   ARCH 1 (vnějšek)  levá půlka = str. 4 (zadní obálka)  · pravá = str. 1 (titul)
 *   ARCH 2 (vnitřek)  levá půlka = str. 2 (osobní údaje)  · pravá = str. 3 (výsledky)
 *
 * Po přeložení jde karta číst 1 → 2 → 3 → 4. Na str. 1 se vyplňuje jméno (aby
 * byla karta adresná hned po převzetí), na str. 2 kontakt (e-mail, telefon,
 * věk) — to je zároveň offline záložní kanál k webové registraci.
 *
 * Geometrie (bleed 3 mm): trim 1122×794 px @96dpi, artboard (= bleed box)
 * 1144×816 px, lom uprostřed na x = 572. Kritický obsah drží SAFE (44 px) od
 * hrany artboardu a stejnou rezervu od lomu — přes lom nesmí nic důležitého.
 * Vyplňovací linky jsou plné 1,5 px tahy, ne tečkované: na levném tisku
 * tečkovaná linka mizí a propiska po ní neklouže.
 * ───────────────────────────────────────────────────────────────────────── */
const A4L_W = 1144;
const A4L_H = 816;
const A4L_PRINT = { paper: "a4", orientation: "landscape", bleedMm: 3 } as const;
const KSAFE = 44;                 // rezerva od hrany artboardu
const FOLD = A4L_W / 2;           // osa lomu
const PW = FOLD - KSAFE * 2;      // využitelná šířka jedné A5 stránky

/* Jedna vyplňovací kolonka: popisek + linka. `w` v procentech řádku. */
function FillLine({ label, hint, dark = false, h = 40, style }: any) {
  /* Linka měla 30 px, což je na A5 ≈ 5,4 mm — pod tím, co propiska potřebuje.
   * 40 px ≈ 7,2 mm. Tón zesílen z 45 % na 65 %: 45% rastr tmavé zelené je na
   * levném tisku nespolehlivý a linka místy zmizí. */
  const line = dark ? "rgba(255,255,255,0.6)" : "rgba(19,50,43,0.65)";
  return (
    <div style={{ ...style }}>
      <div style={{ ...mono(10, dark ? Y : G) }}>{label}</div>
      <div style={{ height: h, borderBottom: `1.5px solid ${line}` }} />
      {/* body(11) ≈ 8,25 pt — karta se vyplňuje venku, po sprintu, k večeru. */}
      {hint ? <div style={{ ...body(13, dark ? GRAY : INK_2), marginTop: 5 }}>{hint}</div> : null}
    </div>
  );
}

/* Každá disciplína má vždy tři pokusy → tři chlívky. Rozšířeno z 58 na 80 px
 * (1aGh 6. 10. 2026): 58 px ≈ 15 mm bylo na A5 u delších čísel ("112", "4,85")
 * těsné na psaní propiskou a trojice vizuálně nesahala ani do poloviny
 * tabulky. 80 px × 3 ≈ polovina šířky PW. Hlavička tabulky bere stejnou
 * šířku, ať sloupce lícují. */
const POKUSY = 3;
const POKUS_W = 80;
const RULE = "1.5px solid rgba(19,50,43,0.22)";

/* Řádek tabulky výsledků — číslo, disciplína, jednotka, tři prázdná pole. */
function ResultRow({ d, last = false }: any) {
  return (
    <div style={{ display: "flex", alignItems: "stretch", borderTop: RULE, borderBottom: last ? RULE : undefined }}>
      <div style={{ width: 30, flexShrink: 0, display: "flex", alignItems: "center" }}>
        <span style={disp(19, { color: G })}>{d.n}</span>
      </div>
      <div style={{ flex: 1, minWidth: 0, padding: "7px 8px 7px 0" }}>
        <div style={disp(21, { color: INK })}>{d.name}</div>
        <div style={{ ...body(11, INK_2), marginTop: 2 }}>{d.meri}</div>
      </div>
      {/* Prázdná pole na naměřené hodnoty — žlutý podtisk, ať měřič na první
       * pohled vidí, kam píše, a ať karta po vyplnění vypadá dokončeně. */}
      {Array.from({ length: POKUSY }, (_, i) => (
        <div key={i} style={{ width: POKUS_W, flexShrink: 0, borderLeft: RULE, background: "rgba(255,205,0,0.12)" }} />
      ))}
    </div>
  );
}

/* Popisky sloupců nad chlívky — „POKUS" přes celou trojici, pod ním 1 / 2 / 3.
 * „1. POKUS" do 58px sloupce v mono 10 nevejde a popisky se slévaly. */
function PokusyHlavicka() {
  return (
    <div style={{ width: POKUS_W * POKUSY }}>
      <div data-cd-id="pokus" style={{ ...mono(10, G), textAlign: "center", whiteSpace: "nowrap" }}>POKUS</div>
      <div style={{ display: "flex", marginTop: 4 }}>
        {Array.from({ length: POKUSY }, (_, i) => (
          <div key={i} style={{ width: POKUS_W, textAlign: "center" }}>
            <span style={disp(19, { color: G })}>{i + 1}</span>
          </div>
        ))}
      </div>
    </div>
  );
}

