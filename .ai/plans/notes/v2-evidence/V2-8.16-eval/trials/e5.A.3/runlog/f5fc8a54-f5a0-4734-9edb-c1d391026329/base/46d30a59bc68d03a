      <div style={{ position: "absolute", inset: 0, zIndex: 2, background: `linear-gradient(180deg, rgba(12,33,27,0.55) 0px, rgba(12,33,27,0.1) 340px, rgba(12,33,27,0.75) 600px, ${G} 740px)` }} aria-hidden="true" />

