/* ─────────────────────────────────────────────────────────────────────────
 * FACEBOOK EVENT COVER — geometrie a safe zóna
 *
 * Facebook doporučuje pro cover události 1920×1005 px (poměr 1.91:1); starší
 * 1920×1080 se na mobilu ořezává shora a zdola, proto tenhle rozměr. Plocha se
 * ale NEZOBRAZÍ celá všude — obrázek se v užších kontextech ořezává na střed:
 *
 *   · DESKTOP     — celých 1920×1005 nad detailem události.
 *   · MOBIL       — ořez na střed, uříznou se levý a pravý okraj. Držíme
 *                   konzervativní pás 1240 px na střed → 340 px rezerva
 *                   z každé strany.
 *   · NÁHLED/FEED — dlaždice se vykresluje ve 516×315 (poměr 1.638:1). Zpětně
 *                   přepočteno na náš canvas to je střed 1646×1005, tedy
 *                   137 px z každé strany pryč.
 *
 * Pravidlo pro kompozici: logo, headline, datum a místo musí ležet uvnitř
 * SAFE_MOBILE. Fotka, ghost wordmark a halftone smí přetékat až do hrany —
 * to je dekorace, u které ořez nevadí.
 *
 * Zdroje (ověřeno 2. 9. 2026): socialsizes.io/facebook-cover-photo-size,
 * postfa.st/sizes/facebook/event-cover, birdeye.com blog „facebook event
 * cover photo size". Před další kampaní ověřit znovu — Facebook rozměry mění.
 * ───────────────────────────────────────────────────────────────────────── */
const EV_MOBILE_INSET = 340;   // mobilní ořez na střed → bezpečný pás 1240 px
const EV_TILE_INSET = 137;     // náhledová dlaždice 516×315 → střed 1646 px

/* Vodítka safe zóny. Renderuje se JEN na kontrolním artboardu, nikdy v exportu. */
function EventGuides() {
  const band = (inset: number, color: string, label: string, top: number) => (
    <>
      <div aria-hidden="true" style={{ position: "absolute", left: inset, top: 0, bottom: 0, width: FMT.event.w - inset * 2, border: `2px dashed ${color}`, pointerEvents: "none" }} />
      <div aria-hidden="true" style={{ position: "absolute", left: 0, top: 0, bottom: 0, width: inset, background: `${color}22`, pointerEvents: "none" }} />
      <div aria-hidden="true" style={{ position: "absolute", right: 0, top: 0, bottom: 0, width: inset, background: `${color}22`, pointerEvents: "none" }} />
      <div style={{ position: "absolute", left: inset + 12, top, ...mono(12, color), background: "rgba(6,14,12,0.8)", padding: "6px 10px" }}>{label}</div>
    </>
  );
  return (
    <div style={{ position: "absolute", inset: 0, zIndex: 9 }}>
      {band(EV_TILE_INSET, "#7FD4FF", `NÁHLEDOVÁ DLAŽDICE · STŘED ${FMT.event.w - EV_TILE_INSET * 2} PX`, 16)}
      {band(EV_MOBILE_INSET, "#FF6B6B", `MOBILNÍ OŘEZ · STŘED ${FMT.event.w - EV_MOBILE_INSET * 2} PX`, 900)}
    </div>
  );
}

