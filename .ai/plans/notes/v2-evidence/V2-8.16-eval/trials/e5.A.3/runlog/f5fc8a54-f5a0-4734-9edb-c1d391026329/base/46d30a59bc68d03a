/* Co-branding s VUT — hostitel akce (stadion v areálu CESA VUT v Brně). Logo
 * VUT musí být na KAŽDÉ sociální kreativě kampaně (1aGh 4. 10. 2026), proto
 * jeden lockup místo holého <Logo>. Verze značky dle manuálu JVS VUT: na tmavé
 * zeleni negativ, na papíře barevná, na žluté černá monochromní (červená na
 * žluté nemá kontrast, bílá zmizí) — `cerna` = negativ přebarvený filtrem.
 * VUT = 0,8 h, aby host nepřebil klubovou značku; mezera k dělicí linii =
 * ochranná zóna X (⅓ výšky VUT). `stack` = VUT pod logem (úzké hlavičky). */
function LogoVUT({ tone = "white", h = 50, variant = "mark", vut, stack = false, style }: any) {
  const vh = Math.max(36, Math.round(h * 0.8));
  const x = Math.round(vh / 3);
  const verze = vut || (tone === "white" ? "negativ" : "barva");
  const vutImg = (
    <img src={`${A}/partners/${verze === "barva" ? "vut" : "vut-negativ"}.svg`} alt="Vysoké učení technické v Brně"
      style={{ height: vh, display: "block", filter: verze === "cerna" ? "brightness(0)" : undefined }} />
  );
  if (stack) {
    return (
      <div style={{ display: "flex", flexDirection: "column", alignItems: "flex-end", gap: x, ...style }}>
        <Logo variant={variant} tone={tone} h={h} />
        {vutImg}
      </div>
    );
  }
  return (
    <div style={{ display: "flex", alignItems: "center", gap: x, ...style }}>
      <Logo variant={variant} tone={tone} h={h} />
      <span aria-hidden="true" style={{ width: 2, height: vh, background: tone === "white" ? "rgba(255,255,255,0.32)" : "rgba(19,50,43,0.3)" }} />
      {vutImg}
    </div>
  );
}

function ChTag({ kind, style }: any) {
  const c = CH[kind];
  return (
    <span style={{ ...mono(12, c.fg), background: c.bg, border: `1.5px solid ${c.bd}`, padding: "4px 11px", letterSpacing: "0.16em", fontWeight: 700, whiteSpace: "nowrap", ...style }}>
      {c.label}
    </span>
  );
}

