/**
 * @canvas      {{NAME}} — brief canvas
 * @ds          {{DS_NAME}}
 * @platform    {{PLATFORM}}
 * @kind        brief-board
 * @stack       React 19 · TSX · Bun.build
 * @history     {{HISTORY_DIR}}
 *
 * Annotation-only brief canvas (Phase 22). This canvas is born EMPTY on purpose:
 * one framed reference artboard you fill with sticky notes, text and arrows
 * describing what each artboard should do. When `/design:new` runs again while
 * this canvas is the active one, the agent reads those annotations as a VERBATIM
 * brief and inserts the matching generated artboards right here, below this
 * frame — the canvas becomes a living brief you sketch and AI fills in. The words
 * on the artboard below are the person's, in the app's voice (no commands, no
 * product names, no key letters): keep them that way.
 *
 * The annotation layer lives in a sibling `<slug>.annotations.json` (NEVER in this
 * file), so your notes stay floating on top across every regeneration. No design
 * system tokens or classes are wired in — the board is a neutral surface; the
 * generated artboards bring the DS with them on ingest.
 */

import { DCArtboard, DCSection, DesignCanvas } from "@maude/canvas-lib";

export default function {{COMPONENT_NAME}}() {
  return (
    <DesignCanvas>
      <DCSection id="brief-board" title="Brief">
        <DCArtboard id="brief" label="Brief" width={1280} height={800}>
          <div
            style={{
              boxSizing: "border-box",
              width: "100%",
              height: "100%",
              display: "flex",
              flexDirection: "column",
              alignItems: "center",
              justifyContent: "center",
              gap: "14px",
              padding: "48px",
              textAlign: "center",
              fontFamily: "ui-sans-serif, system-ui, -apple-system, sans-serif",
              color: "#9aa0a6",
              background: "#ffffff",
              border: "1.5px dashed #d4d8dd",
            }}
          >
            <div style={{ fontSize: "22px", fontWeight: 600, color: "#5f6571" }}>
              {{NAME}}
            </div>
            <div style={{ fontSize: "14px", color: "#8a9099" }}>{{SEED_HINT}}</div>
            <div style={{ fontSize: "13px", maxWidth: "460px", lineHeight: 1.55 }}>
              Add sticky notes, text and arrows here to describe what each
              artboard should do. Then ask AI for a first draft from your notes.
            </div>
          </div>
        </DCArtboard>
      </DCSection>
    </DesignCanvas>
  );
}
