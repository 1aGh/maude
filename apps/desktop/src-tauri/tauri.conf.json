{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maude",
  "version": "1.4.4",
  "identifier": "com.maude.app",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "node scripts/sync-sidecar.mjs && bun scripts/build-cli-binary.mjs && node scripts/sync-agent-browser.mjs && node scripts/sync-kg.mjs && node scripts/stage-resources.mjs",
    "beforeDevCommand": {
      "script": "node scripts/sync-sidecar.mjs && bun scripts/build-cli-binary.mjs && node scripts/sync-agent-browser.mjs && node scripts/sync-kg.mjs && node scripts/stage-resources.mjs",
      "wait": true
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Maude",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:* ws://localhost:*; frame-src http://localhost:*; script-src 'self' 'unsafe-inline' http://localhost:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http://localhost:* asset:; connect-src http://localhost:* ws://localhost:*"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["maude"]
      }
    },
    "updater": {
      "endpoints": ["https://maude.sh/releases/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCRDc0NTEzMjg2OEY1OEQKUldTTjlXZ29FMFhYaTdLRDVML21INzM2NWI5cXBveUp5MFVOcjJ1Rzc0clhKbTdDYkFsZjlZZ0gK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/maude-server", "binaries/agent-browser", "binaries/maude"],
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad", "gstreamer1.0-libav"]
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "resources": {
      "resources/apps/studio": "apps/studio",
      "resources/cli": "cli",
      "resources/package.json": "package.json",
      "resources/plugins/design": "plugins/design",
      "resources/plugins/flow": "plugins/flow",
      "resources/plugins/kgai": "plugins/kgai",
      "resources/kgai": "kgai"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
