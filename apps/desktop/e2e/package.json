{
  "name": "@maude/desktop-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "DOM-driven E2E scenarios for the bundled Maude desktop app (Tauri + WebdriverIO @wdio/tauri-service). Drives the real WKWebView via data-testid — see the repo-internal `desktop-e2e` skill. NOT published; not part of the default build/test fan-out.",
  "type": "module",
  "scripts": {
    "e2e": "wdio run ./wdio.conf.ts",
    "e2e:cloud": "wdio run ./wdio.cloud.conf.ts",
    "e2e:git": "wdio run ./wdio.git.conf.ts",
    "e2e:build": "cd .. && pnpm tauri build --debug",
    "e2e:lifecycle": "wdio run ./wdio.lifecycle.conf.ts",
    "e2e:switchrepos": "wdio run ./wdio.switchrepos.conf.ts",
    "e2e:tabs": "wdio run ./wdio.tabs.conf.ts",
    "e2e:tabs-identity": "wdio run ./wdio.tabs-identity.conf.ts",
    "e2e:cell-tab": "wdio run ./wdio.cell-tab.conf.ts",
    "e2e:ai-quit": "wdio run ./wdio.ai-quit.conf.ts",
    "e2e:generate-takes": "wdio run ./wdio.generate-takes.conf.ts",
    "e2e:relaunch": "wdio run ./wdio.relaunch.conf.ts",
    "e2e:home": "wdio run ./wdio.home.conf.ts",
    "e2e:invite-landing": "wdio run ./wdio.invite-landing.conf.ts",
    "e2e:ds-review": "wdio run ./wdio.ds-review.conf.ts",
    "e2e:ds-review-master": "wdio run ./wdio.ds-review-master.conf.ts",
    "e2e:ds-switch": "wdio run ./wdio.ds-switch.conf.ts",
    "e2e:ds-outside": "wdio run ./wdio.ds-outside.conf.ts",
    "e2e:ds-reach": "wdio run ./wdio.ds-reach.conf.ts",
    "e2e:ds-edges": "wdio run ./wdio.ds-edges.conf.ts",
    "e2e:ds-advanced": "wdio run ./wdio.ds-advanced.conf.ts",
    "e2e:share-roles": "wdio run ./wdio.share-roles.conf.ts",
    "e2e:onboarding": "wdio run ./wdio.onboarding.conf.ts",
    "e2e:acp-cold-start": "wdio run ./wdio.acp-cold-start.conf.ts",
    "e2e:parity": "wdio run ./wdio.parity.conf.ts",
    "e2e:sidecar-respawn": "wdio run ./wdio.sidecar-respawn.conf.ts",
    "e2e:team-project": "wdio run ./wdio.team-project.conf.ts",
    "e2e:s20": "wdio run ./wdio.s20-deployment.conf.ts",
    "e2e:parity:cloud": "MAUDE_E2E_PARITY_CLOUD=1 wdio run ./wdio.parity.conf.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@wdio/cli": "^9.20.0",
    "@wdio/globals": "^9.20.0",
    "@wdio/local-runner": "^9.20.0",
    "@wdio/mocha-framework": "^9.20.0",
    "@wdio/spec-reporter": "^9.20.0",
    "@wdio/tauri-service": "1.1.0",
    "expect-webdriverio": "^5.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
