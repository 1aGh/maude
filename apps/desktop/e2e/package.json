{
  "name": "@maude/desktop-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "DOM-driven E2E scenarios for the bundled Maude desktop app (Tauri + WebdriverIO @wdio/tauri-service). Drives the real WKWebView via data-testid — see the repo-internal `desktop-e2e` skill. NOT published; not part of the default build/test fan-out.",
  "type": "module",
  "scripts": {
    "e2e": "wdio run ./wdio.conf.ts",
    "e2e:cloud": "wdio run ./wdio.cloud.conf.ts",
    "e2e:git": "wdio run ./wdio.git.conf.ts",
    "e2e:build": "cd .. && pnpm tauri build --debug",
    "e2e:lifecycle": "wdio run ./wdio.lifecycle.conf.ts",
    "e2e:switchrepos": "wdio run ./wdio.switchrepos.conf.ts",
    "e2e:onboarding": "wdio run ./wdio.onboarding.conf.ts",
    "e2e:acp-cold-start": "wdio run ./wdio.acp-cold-start.conf.ts",
    "e2e:parity": "wdio run ./wdio.parity.conf.ts",
    "e2e:sidecar-respawn": "wdio run ./wdio.sidecar-respawn.conf.ts",
    "e2e:team-project": "wdio run ./wdio.team-project.conf.ts",
    "e2e:s20": "wdio run ./wdio.s20-deployment.conf.ts",
    "e2e:parity:cloud": "MAUDE_E2E_PARITY_CLOUD=1 wdio run ./wdio.parity.conf.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@wdio/cli": "^10.0.1",
    "@wdio/globals": "^10.0.1",
    "@wdio/local-runner": "^10.0.1",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "@wdio/tauri-service": "1.1.0",
    "expect-webdriverio": "^7.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
