{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "@wdio/globals/types", "@wdio/mocha-framework", "expect-webdriverio"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "fixtures/**/*.ts",
    "helpers/**/*.ts",
    "multiplayer/**/*.ts",
    "scenarios/**/*.ts",
    "wdio.conf.ts",
    "wdio.git.conf.ts",
    "wdio.lifecycle.conf.ts",
    "wdio.switchrepos.conf.ts",
    "wdio.onboarding.conf.ts",
    "wdio.acp-cold-start.conf.ts",
    "wdio.acp-fake.conf.ts",
    "wdio.ai-quit.conf.ts",
    "wdio.cloud.conf.ts",
    "wdio.cell-tab.conf.ts",
    "wdio.team-project.conf.ts",
    "wdio.sidecar-respawn.conf.ts",
    "wdio.share-roles.conf.ts"
  ]
}
