{
  "format": "maude.agent-journey/1",
  "id": "S10",
  "package": "S10",
  "title": "A token change in the design system: read first, change the source, check, say who uses it",
  "ledger": [],
  "fixture": "app5",
  "setup": [],
  "turns": [
    {
      "say": "Which design systems does this project have, and is anything waiting on them?"
