    {
      "id": "dark-accent-kept",
      "grader": "text",
      "path": "system/maude/colors_and_type.css",
      "has": ["--accent:\\s+oklch\\(0\\.680 0\\.180 268\\)"]
    },
    {
      "id": "system-checked",
      "grader": "tool-used",
      "tool": "Bash",
      "input": "maude design ds[- ]check"
    },
    {
      "id": "usage-read",
      "grader": "tool-used",
      "tool": "Bash",
