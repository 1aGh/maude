{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maude.sh/schema/transcript/v1",
  "title": "Maude transcript sidecar (assets/<sha8>.transcript.json), v1",
  "description": "GENERATED by scripts/gen-actions.mjs from apps/studio/video/format-ids.ts — the runtime source is validateTranscript (video/schema.ts). V2-1.10 §5.1: one per source asset with sound, written by transcribe-local / transcribe / maude migrate v2, never by hand. Preserving: a key this build does not know is kept by every reader and writer, so additionalProperties stays open. Rules the schema cannot state: words sorted by t0 with unique ids and t1 > t0; regions sorted and non-overlapping; words [] when engine.id is \"energy\". Word text is untrusted content. Skill: design:video-comp.",
  "type": "object",
  "required": ["format", "v", "asset", "engine", "words", "speech", "createdAt"],
  "properties": {
    "format": {
      "const": "maude.transcript"
    },
    "v": {
      "const": 1
    },
    "asset": {
      "description": "The source asset, \"assets/<sha8>.<ext>\"; its <sha8> is the sidecar file name.",
      "type": "string",
      "pattern": "^assets/[A-Za-z0-9_-]{1,64}\\.[A-Za-z0-9]{1,8}$"
    },
    "durationSec": {
      "type": "number",
      "minimum": 0,
      "maximum": 86400
    },
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2,3}$"
    },
    "engine": {
      "type": "object",
      "required": ["id", "timing"],
      "properties": {
        "id": {
          "enum": ["whisper.cpp", "elevenlabs-scribe", "groq-whisper", "energy", "srt-import"]
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "timing": {
          "enum": ["dtw+energy", "segment", "provider", "cue", "none"]
        },
        "lagMs": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        }
      }
    },
    "words": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/word"
      }
    },
    "speech": {
      "type": "object",
      "required": ["source", "regions"],
      "properties": {
        "source": {
          "enum": ["words", "energy"]
        },
        "regions": {
          "type": "array",
          "maxItems": 20000,
          "items": {
            "$ref": "#/$defs/span"
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "$defs": {
    "word": {
      "type": "object",
      "required": ["id", "t0", "t1", "text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        },
        "t0": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "t1": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "text": {
          "type": "string",
          "maxLength": 64
        },
        "p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "flags": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "enum": ["loop"]
          }
        }
      }
    },
    "span": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 86400
      }
    }
  }
}
