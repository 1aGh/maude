{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maude.sh/schema/annotations/v2",
  "title": "Maude whiteboard (<slug>.annotations.json), format maude.annotations v2",
  "description": "GENERATED from apps/studio/annotations/registry.ts by scripts/gen-actions.mjs — do not edit. The strict reading for AI writes (`maude design check --strict`): unknown fields are errors, every value must load without repair. Coordinates are board-local and rounded to 2 decimals on load; a field equal to its default may be omitted. One element per line, parents before children (serializeBoard). Skill: design:whiteboard.",
  "type": "object",
  "required": ["format", "v", "elements"],
  "properties": {
    "format": {
      "const": "maude.annotations"
    },
    "v": {
      "const": 2
    },
    "elements": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/element"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "element": {
      "description": "One element. Its `type` picks the shape; a type this Maude does not know is kept verbatim by readers (V2-1.12 R4) but an AI write may not create or change one.",
      "oneOf": [
        {
          "$ref": "#/$defs/el-sticky"
        },
        {
          "$ref": "#/$defs/el-text"
        },
        {
          "$ref": "#/$defs/el-shape"
        },
        {
          "$ref": "#/$defs/el-arrow"
        },
        {
          "$ref": "#/$defs/el-pen"
        },
        {
          "$ref": "#/$defs/el-image"
        },
        {
          "$ref": "#/$defs/el-link"
        },
        {
          "$ref": "#/$defs/el-mediaref"
        },
        {
          "$ref": "#/$defs/el-section"
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    },
    "unknown": {
      "description": "An element of a type registered by a newer Maude (read-only for this one).",
      "type": "object",
      "required": ["id", "type", "index"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "not": {
            "enum": [
              "sticky",
              "text",
              "shape",
              "arrow",
              "pen",
              "image",
              "link",
              "mediaref",
              "section"
            ]
          }
        },
        "parent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "index": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z]{1,64}$"
        }
      }
    },
    "el-sticky": {
