{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maude.sh/schema/edl/v1",
  "title": "Maude edit decision list (<slug>.edl.json), v1",
  "description": "The documented shape of an EDL (`/design:reel`, skill design:footage-director). The runtime source is `validateEdl` in apps/studio/footage/schema.ts — `maude design check --strict` runs it; test/schema-drift.test.ts holds this file to the same verdicts on a corpus. Every optional field may also be null. V2-1.12 R8: v1's reader treats an EDL with ANY unknown key as missing, so v2 adds no keys to this format.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "type": ["number", "null"] },
    "title": { "type": ["string", "null"], "maxLength": 300 },
    "fps": { "type": ["number", "null"], "minimum": 1, "maximum": 120 },
    "width": { "type": ["number", "null"], "minimum": 1, "maximum": 100000 },
    "height": { "type": ["number", "null"], "minimum": 1, "maximum": 100000 },
    "beats": {
      "type": ["array", "null"],
      "maxItems": 512,
      "items": { "$ref": "#/$defs/beat" }
    },
    "music": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["asset"],
          "additionalProperties": false,
          "properties": {
            "asset": { "$ref": "#/$defs/asset" },
            "fadeOutFrames": { "$ref": "#/$defs/intGe0" }
          }
        }
      ]
    },
    "audioTracks": {
      "type": ["array", "null"],
      "maxItems": 64,
      "items": { "$ref": "#/$defs/audioTrack" }
    },
    "captions": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["cues"],
          "additionalProperties": false,
          "properties": {
            "cues": { "type": "array", "maxItems": 5000, "items": { "$ref": "#/$defs/cue" } },
            "style": { "enum": ["lower-third", "centered", "top", null] }
          }
        }
      ]
    }
  },
  "$defs": {
    "asset": { "type": "string", "pattern": "^assets/[0-9a-f]{8,}[A-Za-z0-9._-]*$" },
    "intGe0": { "type": ["integer", "null"], "minimum": 0 },
    "intGe1": { "type": ["integer", "null"], "minimum": 1 },
    "sec": { "type": ["number", "null"], "minimum": 0, "maximum": 86400 },
    "beat": {
      "type": "object",
      "required": ["clip"],
      "additionalProperties": false,
      "properties": {
        "clip": { "$ref": "#/$defs/asset" },
        "startSec": { "$ref": "#/$defs/sec" },
        "durationFrames": { "$ref": "#/$defs/intGe1" },
        "why": { "type": ["string", "null"], "maxLength": 1000 },
        "name": { "type": ["string", "null"], "maxLength": 120 },
        "transition": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["presentation"],
              "additionalProperties": false,
              "properties": {
                "presentation": { "enum": ["none", "fade", "slide", "wipe", "flip", "clock-wipe"] },
                "frames": { "$ref": "#/$defs/intGe0" }
              }
            }
          ]
        },
        "overlay": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["kind"],
              "additionalProperties": false,
              "properties": {
                "kind": { "enum": ["title", "lower-third", "caption", "logo"] },
                "text": { "type": ["string", "null"], "maxLength": 500 }
              }
            }
          ]
        }
      }
    },
    "audioTrack": {
      "type": "object",
      "required": ["asset"],
      "additionalProperties": false,
      "properties": {
        "asset": { "$ref": "#/$defs/asset" },
        "kind": { "enum": ["music", "voiceover", "sfx", null] },
        "startFrame": { "$ref": "#/$defs/intGe0" },
        "durationFrames": { "$ref": "#/$defs/intGe1" },
        "gainDb": { "type": ["number", "null"], "minimum": -60, "maximum": 24 },
        "fadeInFrames": { "$ref": "#/$defs/intGe0" },
        "fadeOutFrames": { "$ref": "#/$defs/intGe0" },
        "name": { "type": ["string", "null"], "maxLength": 120 }
      }
    },
    "cue": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "startSec": { "$ref": "#/$defs/sec" },
        "endSec": { "$ref": "#/$defs/sec" },
        "text": { "type": "string", "maxLength": 2000 }
      }
    }
  }
}
