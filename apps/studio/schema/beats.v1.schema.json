{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maude.sh/schema/beats/v1",
  "title": "Maude beat-grid sidecar (assets/<sha8>.beats.json), v1",
  "description": "GENERATED by scripts/gen-actions.mjs from apps/studio/video/format-ids.ts — the runtime source is validateBeats (video/schema.ts). V2-1.10 §5.2: one per music asset, written by `maude design beats` and the studio. Preserving (additionalProperties open). Rule the schema cannot state: beats strictly ascending. beats[bar.phase + 4k] are downbeats; tempoStrength < 0.15 means no clear beat. Skill: design:video-comp.",
  "type": "object",
  "required": [
    "format",
    "v",
    "asset",
    "durationSec",
    "analyzer",
    "bpm",
    "bpmSource",
    "tempoStrength",
    "beats",
    "bar",
    "createdAt"
  ],
  "properties": {
    "format": {
      "const": "maude.beats"
    },
    "v": {
      "const": 1
    },
    "asset": {
      "description": "The source asset, \"assets/<sha8>.<ext>\"; its <sha8> is the sidecar file name.",
      "type": "string",
      "pattern": "^assets/[A-Za-z0-9_-]{1,64}\\.[A-Za-z0-9]{1,8}$"
    },
    "durationSec": {
      "type": "number",
      "minimum": 0,
      "maximum": 86400
    },
    "analyzer": {
      "type": "object",
      "required": ["id", "version", "decode"],
      "properties": {
        "id": {
          "const": "maude-beats"
        },
        "version": {
          "const": 1
        },
        "decode": {
          "enum": ["ffmpeg", "chromium"]
        }
      }
    },
    "bpm": {
      "type": "number",
      "minimum": 20,
      "maximum": 400
    },
    "bpmSource": {
      "enum": ["detected", "set"]
    },
    "tempoStrength": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "beats": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 86400
      }
    },
    "bar": {
      "type": "object",
      "required": ["phase", "confidence"],
      "properties": {
        "phase": {
          "enum": [0, 1, 2, 3]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
